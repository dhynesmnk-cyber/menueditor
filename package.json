    "test:workspace": ".lines/bin/python test/workspace.py",
    "test:project": ".lines/bin/python test/project-export.py",
    "test:shapes": ".lines/bin/python test/export-shapes.py",
    "test:pageops": ".lines/bin/python test/page-ops.py",
    "test:image": ".lines/bin/python test/image-project.py",
    "test:canvas": ".lines/bin/python test/canvas-lines.py out/canvas-shot.png",
    "test:parse": "node test/parse.js",
    "test:inline": "node test/parse-inline.js",
    "test:planner": "node test/planner.js",
    "test:pages": "node test/pagination.js",
    "test:drag": "node test/block-index.js",
    "test:design": "node test/design.js",
    "test:layout": "node test/layout-test.js",
    "test:e2e": "node test/import-e2e.js",
    "test:pdf": "node test/fidelity.js",
    "test:lines": "node test/lines.js",
    "pdf": "node test/fidelity.js",
    "test:ela": "node test/pdf-ela.js"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
